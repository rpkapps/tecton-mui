{
  "name": "tecton-mui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @tecton-mui/ui build && pnpm --filter @tecton-mui/mcp build && pnpm --filter @tecton-mui/docs build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:bundle": "node tooling/bundle-tests/run.mjs",
    "tecton:sync": "pnpm --filter @tecton-mui/tecton-adapter sync",
    "tecton:check": "pnpm --filter @tecton-mui/tecton-adapter check",
    "inventory": "node tooling/compatibility/generate-exports.mjs",
    "inventory:check": "node tooling/compatibility/generate-exports.mjs --check",
    "deps:outdated": "node tooling/scripts/deps-update.mjs --report",
    "deps:update": "node tooling/scripts/deps-update.mjs",
    "docs:sync": "node tooling/docs-sync/sync.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
