{
  "$comment": "Mapping of @mui/icons-material base names (without the Outlined/Rounded/Sharp/TwoTone suffix) to Tecton icon names. docs:sync rewrites the icons of the synced MUI demos to <Icon name=\"...\" /> from @tecton-mui/ui/Icon with it, and fails on an icon without an entry. Icons use Tecton's default outline style; names in \"filled\" use variant=\"filled\" because the demos pair them with an outline counterpart to show a state (checked, selected, rated, bookmarked). \"notes\" gives the reason for each icon that is only a stand-in for a symbol Tecton does not have.",
  "filled": ["Bookmark", "CheckBox", "Favorite", "RadioButtonChecked", "Star"],
  "notes": {
    "BeachAccess": "No beach or holiday icon in Tecton: the sun (light-mode) stands for the \"Vacation\" folder.",
    "Bluetooth": "No Bluetooth icon in Tecton: the link icon (pairing a device) stands for the Bluetooth setting.",
    "Cloud": "No cloud icon in Tecton: the database icon (stored online) stands for the \"Web Clipboard\" menu item.",
    "Fastfood": "No food icon in Tecton: the leaf (co2-leaf) stands for the \"Eat\" timeline step.",
    "FormatBold": "No text-formatting icons in Tecton: line-weight (heavier strokes) stands for bold, distinct from italic and underline in the same toggle group.",
    "FormatItalic": "No text-formatting icons in Tecton: the pen (annotate) stands for italic, distinct from bold and underline in the same toggle group.",
    "FormatUnderlined": "No text-formatting icons in Tecton: the horizon line stands for underline, distinct from bold and italic in the same toggle group.",
    "Phone": "No phone icon in Tecton: the chat icon (a conversation) stands for a call.",
    "PhoneAndroid": "No mobile-device icon in Tecton: the panel icon stands for the phone option, next to the window icon used for laptop and TV.",
    "PhoneMissed": "No phone icon in Tecton: the notification bell stands for a missed call.",
    "Print": "No printer icon in Tecton: the report icon (a document) stands for printing.",
    "Wifi": "No Wi-Fi icon in Tecton: the pulse icon (a signal) stands for the Wi-Fi setting."
  },
